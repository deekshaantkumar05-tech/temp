<?xml version="1.0"?>

<labwc_config>

  <core>
    <decoration>server</decoration>
    <allowRemoteActions>yes</allowRemoteActions>
  </core>

  <keyboard>
    <keybind key="W-Return">
      <action name="Execute">
        <command>foot</command>
      </action>
    </keybind>

    <keybind key="W-space">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </keybind>

    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <keybind key="W-S-r">
      <action name="Reconfigure" />
    </keybind>

    <keybind key="W-S-e">
      <action name="Exit" />
    </keybind>
  </keyboard>

</labwc_config>
